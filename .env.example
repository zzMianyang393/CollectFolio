# CollectFolio environment variables
# Copy to .env for local development. Set the same vars in Cloudflare Pages dashboard for production.
#
# In Cloudflare Pages: Settings → Environment variables
# https://dash.cloudflare.com → Workers & Pages → your project → Settings → Environment variables

# --- Public (exposed to client, baked at build time) ---

# Cloudflare Web Analytics token
# Get from: Cloudflare dashboard → Analytics → Web Analytics → Add site → copy token
PUBLIC_CF_ANALYTICS_TOKEN=

# Google Search Console verification code
# Get from: GSC → Add property → URL prefix → HTML tag method → copy content value
PUBLIC_GSC_VERIFICATION=

# Microsoft Clarity project ID (optional, for heatmaps)
# Get from: clarity.microsoft.com → Add project → copy ID
PUBLIC_CLARITY_ID=

# --- Secret (server-side only, accessed via context.env) ---

# Cloudflare D1 binding (set automatically by wrangler / Pages dashboard, no manual value needed)
DB=

# Resend API key for transactional email (optional)
# Get from: resend.com/api-keys
RESEND_API_KEY=

# Allowed origin for waitlist CORS (defaults to https://collectfolio.pages.dev)
ALLOWED_ORIGIN=https://collectfolio.pages.dev