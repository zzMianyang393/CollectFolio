---
interface Props {
  source?: string;
  buttonLabel?: string;
  placeholder?: string;
}

const {
  source = 'unknown',
  buttonLabel = 'Notify me',
  placeholder = 'you@example.com',
} = Astro.props;
---

<form
  class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row"
  data-waitlist-form
  data-source={source}
  aria-label="Email signup"
>
  <label class="sr-only" for={`email-${source}`}>Email address</label>
  <input
    id={`email-${source}`}
    type="email"
    name="email"
    required
    placeholder={placeholder}
    autocomplete="email"
    class="flex-1 rounded-md border border-border bg-bg px-4 py-3 outline-none transition-colors placeholder:text-fg-muted focus:border-accent"
  />
  <input type="hidden" name="source" value={source} />
  <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for={`website-${source}`}>Website</label>
    <input
      id={`website-${source}`}
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <button
    type="submit"
    class="inline-flex items-center justify-center gap-2 rounded-md bg-accent px-6 py-3 font-semibold text-accent-fg transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span data-label>{buttonLabel}</span>
  </button>
</form>

<p data-waitlist-status class="mt-3 hidden text-center text-sm" role="status"></p>

<script>
  // Progressive enhancement: client-side submit handler.
  // Backend endpoint will be /api/waitlist (Cloudflare Worker).
  // Falls back to Tally iframe if Worker not yet deployed.
  const forms = document.querySelectorAll<HTMLFormElement>('[data-waitlist-form]');
  forms.forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('[data-waitlist-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = form.querySelector<HTMLElement>('[data-label]');
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const website = (form.elements.namedItem('website') as HTMLInputElement | null)?.value ?? '';
      const source = form.dataset.source ?? 'unknown';

      if (!email) return;

      const originalLabel = label?.textContent ?? 'Submit';
      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending...';

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            source,
            website,
            landingPath: `${window.location.pathname}${window.location.search}`,
            referrer: document.referrer,
          }),
        });

        if (!res.ok) throw new Error('Network response was not ok');

        if (status) {
          status.textContent = "Thanks! You're on the CollectFolio waitlist.";
          status.className = 'mt-3 block text-center text-sm text-accent';
        }
        window.dispatchEvent(new CustomEvent('collectfolio:waitlist-signup', {
          detail: { source, path: window.location.pathname },
        }));
        form.reset();
      } catch (err) {
        if (status) {
          status.textContent = 'Something went wrong. Try again or email hello@collectfolio.com.';
          status.className = 'mt-3 block text-center text-sm text-red-500';
        }
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = originalLabel;
      }
    });
  });
</script>
