---
import Layout from '../../layouts/Layout.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const wordCount = (body: string | undefined) => (body ?? '').split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(wordCount(post.body) / 200));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'CollectFolio',
    url: 'https://collectfolio.pages.dev',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}`, Astro.site ?? 'https://collectfolio.pages.dev').toString(),
  },
};

// Find related posts (same category, exclude self)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  jsonLd={articleJsonLd}
>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="font-mono font-semibold text-accent">{post.data.category}</span>
        <span class="text-fg-muted">·</span>
        <time datetime={post.data.pubDate.toISOString()} class="text-fg-muted">
          {formatDate(post.data.pubDate)}
        </time>
        <span class="text-fg-muted">·</span>
        <span class="text-fg-muted">{readingMinutes} min read</span>
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-6 text-xl text-fg-muted">
        {post.data.description}
      </p>
      <div class="mt-6 text-sm text-fg-muted">
        By {post.data.author}
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-lg max-w-none
      prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-2xl
      prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl
      prose-p:my-4 prose-p:leading-relaxed
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-strong:text-fg prose-strong:font-semibold
      prose-code:rounded prose-code:bg-bg-elevated prose-code:px-1.5 prose-code:py-0.5
      prose-code:before:content-none prose-code:after:content-none
      prose-ul:my-4 prose-ol:my-4
      prose-li:my-1
    ">
      <Content />
    </div>

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-border pt-6">
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-border px-3 py-1 text-xs text-fg-muted">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </article>

  <!-- Related posts -->
  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-6 py-12 border-t border-border">
      <h2 class="text-2xl font-bold tracking-tight">More on {post.data.category}</h2>
      <ul class="mt-6 space-y-2">
        {related.map((r) => (
          <li>
            <a
              href={`/blog/${r.id}`}
              class="block rounded-lg border border-border p-4 transition-colors hover:border-accent"
            >
              <h3 class="font-semibold">{r.data.title}</h3>
              <p class="mt-1 text-sm text-fg-muted">{r.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="rounded-2xl border border-border bg-bg-elevated p-8 text-center">
      <h2 class="text-2xl font-bold tracking-tight">
        Track everything we just talked about
      </h2>
      <p class="mt-3 text-fg-muted">
        CollectFolio pulls live prices, tracks your portfolio, and generates insurance reports.
      </p>
      <div class="mt-6">
        <WaitlistForm source={`blog-${post.id}`} />
      </div>
    </div>
  </section>
</Layout>