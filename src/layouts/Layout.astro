---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Track Pokemon cards, LEGO, watches, and vinyl in one portfolio. Total value, real returns, insurance reports — without the spreadsheet.',
  canonical,
  ogImage = '/og-default.svg',
  type = 'website',
  jsonLd,
} = Astro.props;

const SITE_NAME = 'CollectFolio';
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonicalURL = canonical
  ?? new URL(Astro.url.pathname, Astro.site ?? 'https://collectfolio.pages.dev').toString();
const ogImageURL = new URL(ogImage, Astro.site ?? 'https://collectfolio.pages.dev').toString();

// Site-wide Organization schema (always present)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: Astro.site?.toString() ?? 'https://collectfolio.pages.dev',
  logo: new URL('/favicon.svg', Astro.site ?? 'https://collectfolio.pages.dev').toString(),
  description: 'Cross-category collectibles portfolio manager.',
};

// Merge any page-specific JSON-LD with the site-wide Organization
const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [orgJsonLd, ...jsonLd] : [orgJsonLd, jsonLd]
  : [orgJsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Blog`} href="/rss.xml" />

    <!-- Theme color (mobile browser chrome) -->
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Google Search Console verification (set PUBLIC_GSC_VERIFICATION env var) -->
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}

    <!-- JSON-LD -->
    {allJsonLd.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Cloudflare Web Analytics (set PUBLIC_CF_ANALYTICS_TOKEN env var) -->
    {import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN })}
      />
    )}

    <!-- Microsoft Clarity heatmaps (optional, set PUBLIC_CLARITY_ID env var) -->
    {import.meta.env.PUBLIC_CLARITY_ID && (
      <script is:inline type="text/javascript" set:html={`
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "${import.meta.env.PUBLIC_CLARITY_ID}");
      `} />
    )}
  </head>
  <body class="bg-bg text-fg font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-accent-fg focus:rounded focus:shadow-lg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
